# Supabase — txtrpg와 동일한 프로젝트/키를 사용한다.
# Supabase 프로젝트 > Settings > API 에서 복사
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# 시드 적재 RPC 토큰 (migration 036, tools/seed-load.mjs)
SEED_TOKEN=

# 캐릭터 이미지 생성 도구 (tools/gen-char.mjs) 전용. 앱 실행에는 필요 없다.
GEMINI_API_KEY=
